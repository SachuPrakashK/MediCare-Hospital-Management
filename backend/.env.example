NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_characters
REFRESH_TOKEN_SECRET=replace_with_a_different_32_character_secret
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION_DAYS=7
FRONTEND_URL=http://localhost:4200
FILE_UPLOAD_PATH=./uploads
# Production must use vercel-blob. Local is for development/test only.
FILE_STORAGE_DRIVER=local
# Vercel Blob uses either BLOB_READ_WRITE_TOKEN, or BLOB_STORE_ID with VERCEL_OIDC_TOKEN.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
FRONTEND_RESET_URL=http://localhost:4200/auth/reset-password
NOTIFICATION_WEBHOOK_URL=
# Configure either SMTP or NOTIFICATION_WEBHOOK_URL for password reset delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# Use ollama for a local no-API-fee model, openai for the hosted adapter, or disabled.
AI_PROVIDER=disabled
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1000
AI_CONVERSATION_RETENTION_DAYS=30
LOG_LEVEL=info
SEED_HOSPITAL_ADMIN_EMAIL=admin@medicare.test
SEED_HOSPITAL_ADMIN_PASSWORD=CHANGE_ME_WITH_AT_LEAST_12_CHARACTERS
SEED_HOSPITAL_ADMIN_FIRST_NAME=Hospital
SEED_HOSPITAL_ADMIN_LAST_NAME=Admin
